{
  "name": "cu-capability-system",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation system: LLM discovery -> capability artifact -> deterministic replay, with escalation and safety guardrails.",
  "type": "module",
  "scripts": {
    "serve": "npm run build && tsx cli.ts serve",
    "target-app": "tsx target-app/server.ts",
    "discover": "tsx cli.ts discover",
    "replay": "tsx cli.ts replay",
    "list": "tsx cli.ts list",
    "validate": "tsx cli.ts validate",
    "eval": "tsx scripts/evaluate-run.ts",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run typecheck:ui && npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.config.ts",
    "typecheck:ui": "tsc --project tsconfig.ui.json"
  },
  "dependencies": {
    "@ai-sdk/azure": "4.0.62",
    "@ai-sdk/openai": "4.0.59",
    "@assistant-ui/ai-sdk": "0.0.4",
    "@assistant-ui/react": "0.15.18",
    "ai": "7.0.93",
    "express": "^4.19.2",
    "openai": "^4.77.0",
    "playwright": "^1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    },
    "body-parser": {
      "qs": "6.16.0"
    }
  }
}
