{
  "schemaVersion": 1,
  "id": "drift-lookup-member-balance",
  "name": "drift-lookup-member-balance",
  "description": "Drift fixture: same lookup flow, but the Search-button step has only the role-tier locator, so a renamed button (BREAK_MARKUP=1) forces escalation",
  "version": "1.0.0",
  "status": "approved",
  "app": {
    "appId": "cu-nexus",
    "entryUrl": "http://localhost:4173/",
    "allowedOrigins": [
      "http://localhost:4173"
    ]
  },
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "Member number to look up",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savingsBalance",
      "type": "string",
      "description": "Current savings balance as displayed"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "open the member inquiry screen from the main menu",
      "action": "click",
      "target": {
        "description": "Member Inquiry / Maintenance tile on the main menu",
        "frame": "workarea",
        "strategies": [
          {
            "kind": "role",
            "role": "link",
            "name": "Member Inquiry / Maintenance"
          },
          {
            "kind": "text",
            "text": "Member Inquiry / Maintenance",
            "exact": true
          }
        ]
      },
      "risk": "read",
      "timeoutMs": 10000
    },
    {
      "id": "s2",
      "intent": "enter the member number in the search field",
      "action": "fill",
      "target": {
        "description": "member number / last name search input",
        "frame": "workarea",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "q"
          },
          {
            "kind": "css",
            "selector": "form input[type=text]"
          }
        ]
      },
      "value": "{{memberId}}",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s3",
      "intent": "run the search",
      "action": "click",
      "target": {
        "description": "Search submit button",
        "frame": "workarea",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Search"
          }
        ]
      },
      "risk": "read",
      "timeoutMs": 4000
    },
    {
      "id": "s4",
      "intent": "open the matching member record from the results table",
      "action": "click",
      "target": {
        "description": "result row link bearing the member number",
        "frame": "workarea",
        "strategies": [
          {
            "kind": "role",
            "role": "link",
            "name": "{{memberId}}"
          },
          {
            "kind": "text",
            "text": "{{memberId}}",
            "exact": true
          }
        ]
      },
      "risk": "read",
      "timeoutMs": 10000
    },
    {
      "id": "s5",
      "intent": "confirm the member profile screen is showing",
      "action": "assert",
      "assert": {
        "kind": "textVisible",
        "text": "Member Profile",
        "frame": "workarea"
      },
      "risk": "read",
      "timeoutMs": 10000
    },
    {
      "id": "s6",
      "intent": "read the savings balance from the accounts table",
      "action": "extract",
      "target": {
        "description": "current-balance cell of the SAVINGS row",
        "frame": "workarea",
        "strategies": [
          {
            "kind": "css",
            "selector": "tr:has(> td:text-is('SAVINGS')) > td:nth-of-type(4)"
          }
        ]
      },
      "extract": {
        "output": "savingsBalance"
      },
      "risk": "read",
      "timeoutMs": 10000
    }
  ],
  "successCondition": {
    "kind": "urlMatches",
    "pattern": "/members/{{memberId}}(\\?.*)?$"
  },
  "detectors": [
    {
      "id": "no-records-found",
      "description": "Inquiry returned no matching member records",
      "match": {
        "kind": "textVisible",
        "text": "No records found"
      },
      "classification": "business_outcome",
      "outcomeCode": "NO_SUCH_MEMBER"
    },
    {
      "id": "session-expired",
      "description": "Session timed out; flow state is lost and requires sign-on",
      "match": {
        "kind": "textVisible",
        "text": "Your session has timed out"
      },
      "classification": "fatal"
    },
    {
      "id": "maintenance-interstitial",
      "description": "Dismissable scheduled-maintenance notice",
      "match": {
        "kind": "textVisible",
        "text": "SCHEDULED MAINTENANCE NOTICE"
      },
      "classification": "recoverable",
      "recovery": {
        "action": "click",
        "target": {
          "description": "Continue link on the maintenance notice",
          "strategies": [
            {
              "kind": "role",
              "role": "link",
              "name": "Continue to application"
            },
            {
              "kind": "text",
              "text": "Continue to application",
              "exact": true
            }
          ]
        }
      }
    }
  ],
  "provenance": {
    "discoveredAt": "2026-08-13T00:00:00.000Z",
    "model": "(hand-written fixture)",
    "discoveryRunId": "hand-authored",
    "goal": "Look up a member and read their current savings balance"
  }
}