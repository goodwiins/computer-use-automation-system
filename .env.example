# Copy to .env. Keep all real values out of version control.
MERIDIAN_TELLER_OPERATOR=teller1
MERIDIAN_TELLER_PASSWORD=
MERIDIAN_SUPERVISOR_OPERATOR=super1
MERIDIAN_SUPERVISOR_PASSWORD=
MERIDIAN_BRANCH=MAIN-001
# Three distinct random values, each at least 32 characters. Keep the HMAC key stable.
CALLER_API_TOKEN=
OPERATOR_API_TOKEN=
JOURNAL_HMAC_KEY=
CALLER_CAPABILITIES=meridian-sign-on,meridian-member-inquiry,meridian-member-record,meridian-funds-transfer,meridian-open-share,meridian-update-member,meridian-place-hold
EVIDENCE_DIR=evidence/meridian
ARTIFACT_DIR=artifacts
PORT=4180
# Opt-in local demo: teller selection needs no credential; supervisor still does.
LOCAL_TELLER_LOGIN=0
# Configure one provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional local PostgreSQL conversations; keep UUIDs and encryption key stable.
# DATABASE_URL=postgresql://meridian_local@127.0.0.1:55443/meridian_local
# LOCAL_CONVERSATION_SUBJECTS={"caller":"11111111-1111-4111-8111-111111111111","operator":"22222222-2222-4222-8222-222222222222"}
# CONVERSATION_TEXT_KEY=<64 lowercase hex characters from 32 random bytes>
