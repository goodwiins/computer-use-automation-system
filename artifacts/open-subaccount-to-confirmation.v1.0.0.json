{
  "schemaVersion": 1,
  "id": "open-subaccount-to-confirmation",
  "name": "open-subaccount-to-confirmation",
  "description": "For member {{memberId}}, start opening a new sub-account of type Secondary Savings with nickname {{nickname}} and initial deposit {{deposit}}. Stop at the confirmation review screen — do NOT click Open Account — and read the confirmed nickname and deposit from the review table.",
  "version": "1.0.0",
  "status": "approved",
  "app": {
    "appId": "cu-nexus",
    "entryUrl": "http://localhost:4173/",
    "allowedOrigins": [
      "http://localhost:4173"
    ]
  },
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "Invocation parameter \"memberId\"",
      "required": true,
      "sensitive": false
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Invocation parameter \"nickname\"",
      "required": true,
      "sensitive": false
    },
    {
      "name": "deposit",
      "type": "string",
      "description": "Invocation parameter \"deposit\"",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "confirmedNickname",
      "type": "string",
      "description": "Extracted during the flow at step s10"
    },
    {
      "name": "confirmedDeposit",
      "type": "string",
      "description": "Extracted during the flow at step s11"
    }
