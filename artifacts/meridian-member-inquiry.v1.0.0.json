{
  "schemaVersion": 2,
  "id": "meridian-member-inquiry",
  "name": "meridian-member-inquiry",
  "description": "Sign on using server references and nameAttr operator, password, branch; omit frame for main page. Search Member Inquiry using searchMode and searchValue. Use the observed table structure to extract matching rows as members with memberNumber and name columns, excluding its td header row. Do not select a match. Assert a stable results-page checkpoint. Never choose among ambiguous results.",
  "version": "1.0.0",
  "status": "approved",
  "app": {
    "appId": "meridian",
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
    "allowedOrigins": [
      "https://web-sample.interface-hiring.com"
    ]
  },
  "parameters": [
    {
      "name": "searchMode",
      "type": "string",
      "description": "Search by member number or last name",
      "required": true,
      "sensitive": false,
      "enum": [
        "number",
        "name"
      ]
    },
    {
      "name": "searchValue",
      "type": "string",
      "description": "Exact search value",
      "required": true,
      "sensitive": true
    },
    {
      "name": "operator",
      "type": "string",
      "description": "Runtime-bound operator context",
      "required": true,
      "sensitive": true,
      "source": "server"
    },
    {
      "name": "password",
      "type": "string",
      "description": "Runtime-bound operator context",
      "required": true,
      "sensitive": true,
      "source": "server"
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Runtime-bound operator context",
      "required": true,
      "sensitive": true,
      "source": "server"
    }
  ],
  "outputs": [
    {
      "name": "members",
      "type": "table",
      "description": "Extracted during the flow at step s10",
      "sensitive": true,
      "columns": [
        {
          "name": "memberNumber",
          "selector": "td:nth-of-type(1)",
          "type": "string",
          "sensitive": true
        },
        {
          "name": "name",
          "selector": "td:nth-of-type(2)",
          "type": "string",
          "sensitive": true
        }
      ],
      "minRows": 0
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "Enter the server-referenced operator ID for sign-on.",
      "action": "fill",
      "target": {
        "description": "Enter the server-referenced operator ID for sign-on.",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "operator"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > input:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "input",
          "role": "textbox"
        }
      },
      "value": "{{operator}}",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s2",
      "intent": "Enter the server-referenced password into the sign-on password field using its stable password input type.",
      "action": "fill",
      "target": {
        "description": "Enter the server-referenced password into the sign-on password field using its stable password input type.",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "password"
          },
          {
            "kind": "css",
            "selector": "input[type=\"password\"]"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(2) > input:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "input",
          "role": "textbox"
        }
      },
      "value": "{{password}}",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s3",
      "intent": "Select the server-referenced branch for sign-on.",
      "action": "select",
      "target": {
        "description": "Select the server-referenced branch for sign-on.",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "branch"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(3) > td:nth-of-type(2) > select:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "select",
          "role": "combobox"
        }
      },
      "value": "{{branch}}",
      "selectBy": "value",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s4",
      "intent": "Submit the completed sign-on form using the server-referenced operator, password, and branch.",
      "action": "click",
      "target": {
        "description": "Submit the completed sign-on form using the server-referenced operator, password, and branch.",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Sign On"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(4) > td:nth-of-type(2) > input:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "input",
          "role": "button",
          "text": "Sign On"
        }
      },
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s5",
      "intent": "Open Member Inquiry from the signed-on main menu.",
      "action": "click",
      "target": {
        "description": "Open Member Inquiry from the signed-on main menu.",
        "strategies": [
          {
            "kind": "role",
            "role": "link",
            "name": "Member Inquiry"
          },
          {
            "kind": "text",
            "text": "Member Inquiry",
            "exact": true
          },
          {
            "kind": "css",
            "selector": "tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(1) > font:nth-of-type(1) > a:nth-of-type(2)"
          }
        ],
        "snapshot": {
          "tag": "a",
          "role": "link",
          "text": "Member Inquiry"
        }
      },
      "risk": "read",
      "timeoutMs": 10000
    },
    {
      "id": "s6",
      "intent": "Set Member Inquiry search mode to the required member-{{searchMode}} mode.",
      "action": "select",
      "target": {
        "description": "Set Member Inquiry search mode to the required member-{{searchMode}} mode.",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "by"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > select:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "select",
          "role": "combobox"
        }
      },
      "value": "{{searchMode}}",
      "selectBy": "value",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s7",
      "intent": "Enter the required member-{{searchMode}} search value.",
      "action": "fill",
      "target": {
        "description": "Enter the required member-{{searchMode}} search value.",
        "strategies": [
          {
            "kind": "nameAttr",
            "name": "q"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(2) > input:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "input",
          "role": "textbox"
        }
      },
      "value": "{{searchValue}}",
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s8",
      "intent": "Run the Member Inquiry search for member {{searchMode}} {{searchValue}}.",
      "action": "click",
      "target": {
        "description": "Run the Member Inquiry search for member {{searchMode}} {{searchValue}}.",
        "strategies": [
          {
            "kind": "role",
            "role": "button",
            "name": "Search"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(2) > td:nth-of-type(2) > input:nth-of-type(2)"
          }
        ],
        "snapshot": {
          "tag": "input",
          "role": "button",
          "text": "Search"
        }
      },
      "risk": "reversible_write",
      "timeoutMs": 10000
    },
    {
      "id": "s9",
      "intent": "Confirm the member inquiry results route; search arguments are supplied by the recorded form steps.",
      "action": "assert",
      "assert": {
        "kind": "urlMatches",
        "pattern": "^https://web-sample\\.interface-hiring\\.com/members\\?"
      },
      "risk": "read",
      "timeoutMs": 10000
    },
    {
      "id": "s10",
      "intent": "Extract the matching data row with named memberNumber and name columns while excluding the table's td header row.",
      "action": "extract",
      "target": {
        "description": "Extract the matching data row with named memberNumber and name columns while excluding the table's td header row.",
        "strategies": [
          {
            "kind": "css",
            "selector": "body > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(3) > td:nth-of-type(1) > table:nth-of-type(1)"
          },
          {
            "kind": "css",
            "selector": "table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(3) > td:nth-of-type(1) > table:nth-of-type(1)"
          }
        ],
        "snapshot": {
          "tag": "table"
        }
      },
      "extract": {
        "output": "members",
        "columns": [
          {
            "name": "memberNumber",
            "selector": "td:nth-of-type(1)",
            "type": "string",
            "sensitive": true
          },
          {
            "name": "name",
            "selector": "td:nth-of-type(2)",
            "type": "string",
            "sensitive": true
          }
        ],
        "rowSelector": "tbody > tr:not(:first-child)"
      },
      "risk": "read",
      "timeoutMs": 10000
    }
  ],
  "successCondition": {
    "kind": "urlMatches",
    "pattern": "/members(?:[?#].*)?$"
  },
  "detectors": [
    {
      "id": "insufficient-funds",
      "description": "Available funds are insufficient",
      "match": {
        "kind": "textVisible",
        "text": "Insufficient available balance in the source share."
      },
      "classification": "business_outcome",
      "outcomeCode": "INSUFFICIENT_FUNDS"
    },
    {
      "id": "validation",
      "description": "Input rejected by the application",
      "match": {
        "kind": "textVisible",
        "text": "could not be validated"
      },
      "classification": "business_outcome",
      "outcomeCode": "VALIDATION_REJECTED"
    },
    {
      "id": "validation-injected",
      "description": "Transaction rejected",
      "match": {
        "kind": "textVisible",
        "text": "TRANSACTION REJECTED"
      },
      "classification": "business_outcome",
      "outcomeCode": "VALIDATION_REJECTED"
    },
    {
      "id": "no-matches",
      "description": "No member records matched the search",
      "match": {
        "kind": "textVisible",
        "text": "No member records matched your search."
      },
      "classification": "business_outcome",
      "outcomeCode": "NO_SUCH_MEMBER"
    },
    {
      "id": "notfound",
      "description": "No matching member record",
      "match": {
        "kind": "textVisible",
        "text": "RECORD NOT FOUND"
      },
      "classification": "business_outcome",
      "outcomeCode": "NO_SUCH_MEMBER"
    },
    {
      "id": "permission",
      "description": "Operator lacks required supervisor authority",
      "match": {
        "kind": "textVisible",
        "text": "SUPERVISOR OVERRIDE REQUIRED"
      },
      "classification": "fatal",
      "outcomeCode": "PERMISSION_DENIED"
    },
    {
      "id": "timeout",
      "description": "Session expired; invoke a new run",
      "match": {
        "kind": "textVisible",
        "text": "YOUR SESSION HAS TIMED OUT"
      },
      "classification": "fatal",
      "outcomeCode": "SESSION_EXPIRED"
    },
    {
      "id": "maintenance",
      "description": "Maintenance notice; safe Continue link returns to menu",
      "match": {
        "kind": "textVisible",
        "text": "SCHEDULED MAINTENANCE IN PROGRESS"
      },
      "classification": "recoverable",
      "recovery": {
        "action": "click",
        "target": {
          "description": "Continue to menu",
          "strategies": [
            {
              "kind": "role",
              "role": "link",
              "name": "Continue"
            }
          ]
        }
      }
    },
    {
      "id": "server",
      "description": "Application error; no automatic transaction retry",
      "match": {
        "kind": "textVisible",
        "text": "APPLICATION ERROR"
      },
      "classification": "fatal",
      "outcomeCode": "APPLICATION_ERROR"
    }
  ],
  "provenance": {
    "discoveredAt": "2026-09-04T03:59:27.359Z",
    "model": "gpt-5.6-luna",
    "discoveryRunId": "dd1bbcfb-7bb3-4d1a-9268-8166493f1f2a",
    "goal": "Sign on using server references and nameAttr operator, password, branch; omit frame for main page. Search Member Inquiry using searchMode and searchValue. Use the observed table structure to extract matching rows as members with memberNumber and name columns, excluding its td header row. Do not select a match. Assert a stable results-page checkpoint. Never choose among ambiguous results."
  }
}